    <textTemplates>
        <name>EmailBody</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;p&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;Bonjour {!Get_Enquete.DelegueEnqueteurReferentName__c}&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;L&apos;enquête « {!Get_Enquete.Name} » que tu as prise en charge ne progresse pas depuis plus de 2 mois.&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;Voici pour rappel les informations principales :&lt;/span&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;Numéro de l&apos;enquête : {!Get_Enquete.Name}&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;Ville : {!Get_Enquete.Ville__c}&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;Nom du mis en cause : {!Get_Enquete.NOMPrenomMEC__c}&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;Date de la dernère mise à jour : {!Get_Enquete.LastModifiedDate}&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;Merci de transférer ce mail à defossez.ph@gmail.com en indiquant la situation de cette enquête :&lt;/span&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;Situation 1 : l’enquête est sous contrôle et c’est Sirius qui n’est pas à jour&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;Situation 2 : l’enquête est sous contrôle et j’attends une échéance (action à réaliser, disponibilité...) pour poursuivre&lt;/span&gt;&lt;/li&gt;&lt;li&gt;Situation 3 : l&apos;enquête est sous contrôle et je vais demander la clôture&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;Situation 4 : l’enquête est au point mort et je vais relancer les actions nécessaires&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;Situation 5 : l’enquête est au point mort et je vais appeler Philippe pour étudier les suites possibles&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;Merci d’avance pour ton retour rapide&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;img src=&quot;https://spa-bordeaux.file.force.com/sfc/dist/version/renditionDownload?rendition=ORIGINAL_Png&amp;amp;versionId=068AZ000002lIk5&amp;amp;operationContext=DELIVERY&amp;amp;contentId=05TAZ00000A7uuz&amp;amp;page=0&amp;amp;d=/a/AZ000000LuBp/192nPhK4nIj7INGzLrf5rZhMXvU8wsIJwbvAKnaAbcg&amp;amp;oid=00D3X000002KdJv&amp;amp;dpt=null&amp;amp;viewId=&quot;&gt;&lt;/p&gt;</text>
